# === REQUIRED ===

# Supabase — Database and authentication
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key for server-side operations (keep secret, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — Transactional email service
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Upstash Redis — Rate limiting
# Create a Redis database at https://console.upstash.com/ and copy the REST credentials
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# === RECOMMENDED ===

# App URL (used for canonical links, OG metadata, email links)
NEXT_PUBLIC_APP_URL=https://sortir.app

# Google Places API — Location autocomplete during onboarding (server-side, keep secret)
# Get this from https://console.cloud.google.com/ (Places API)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Mapbox — Address autocomplete (public token, client-side)
# Get this from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Proxy trust depth for getClientIp()
# Set to the number of trusted reverse proxies in front of the app.
# Railway uses 1 proxy layer, so the default of 1 is correct for Railway deployments.
TRUST_PROXY_DEPTH=1

# Admin emails (comma-separated) for the admin verification review interface
ADMIN_EMAILS=admin@yourdomain.com

# === FUTURE / NOT YET REQUIRED ===

# Stripe (payment integration — not live yet)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
