# Supabase - Database and authentication
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key for server-side operations (keep secret, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend - Transactional email service
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Mapbox - Location/mapping (optional, for address autocomplete)
NEXT_PUBLIC_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN

# Google Places API - Business address autocomplete (server-side, keep secret)
# Get this from https://console.cloud.google.com/ (Places API)
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Upstash Redis - Distributed rate limiting (required for multi-instance deployments)
# Create a Redis database at https://console.upstash.com/ and copy the REST credentials
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Proxy trust depth for getClientIp()
# Set to the number of trusted reverse proxies in front of the app.
# Railway uses 1 proxy layer, so the default of 1 is correct for Railway deployments.
TRUST_PROXY_DEPTH=1

# Admin emails (comma-separated) for the admin verification review interface
ADMIN_EMAILS=admin@yourdomain.com
